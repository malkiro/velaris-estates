{
  "format": "page",
  "id": "blog",
  "label": "Blog",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "Slug"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "placeholder": "",
          "allowTargetBlank": true,
          "single": "heading1"
        }
      },
      "image": {
        "type": "Image",
        "config": {
          "label": "Image",
          "constraint": {
            "width": 1600
          },
          "thumbnails": [
            {
              "name": "thumbnail",
              "width": 400,
              "height": null
            },
            {
              "name": "thumbnail2x",
              "width": 800,
              "height": null
            }
          ]
        }
      },
      "post_date": {
        "type": "Date",
        "config": {
          "label": "Post date",
          "placeholder": ""
        }
      },
      "summary": {
        "type": "Text",
        "config": {
          "label": "Summary",
          "placeholder": ""
        }
      },
      "body": {
        "type": "Group",
        "config": {
          "label": "Body",
          "repeat": true,
          "fields": {
            "heading": {
              "type": "StructuredText",
              "config": {
                "label": "Heading",
                "placeholder": "",
                "allowTargetBlank": false,
                "multi": "heading2"
              }
            },
            "content": {
              "type": "StructuredText",
              "config": {
                "label": "Content",
                "placeholder": "",
                "allowTargetBlank": true,
                "multi": "paragraph,hyperlink,image,list-item,o-list-item,heading3,strong,em"
              }
            }
          }
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {}
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "og_image": {
        "config": {
          "label": "OG Image",
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
